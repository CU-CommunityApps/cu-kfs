<?xml version="1.0" encoding="UTF-8"?>
<!--
    This is the main file for defining how the Import Budget data will map to the Import Budget spreadsheet/workbook.

    Each "sheet" element should correspond to one of the sheets/tabs in the workbook.

    There are two main types of "field" elements:

    [1] POJO-derived value - Has the "STRING" type and uses the "key" attribute to specify the POJO property.
    [2] Literal value - Has the "STATIC" type and uses the "value" attribute to specify the literal. Can be empty.

    NOTE: This XML file doesn't keep track of POJO classes; it only needs to know POJO property names/paths.
 -->
<cemiOutputDefinition>

    <sheet name="Import Budget High Volume" num-header-rows="5" start-column-index="1"
           business-object-class="edu.cornell.kfs.cemi.module.cg.batch.businessobject.CemiImportBudgetFileImportBudgetHighVolumeTabRowBo">
        <field name="Header Key*"      type="STRING" key="headerKey"/>
        <field name="Budget"           type="STRING" key="budget"/>
        <field name="Import Mode"      type="STRING" key="importMode"/>
        <field name="Auto Complete"    type="STRING" key="autoComplete"/>
        <field name="Comment"          type="STRING" key="comment"/>
        <field name="Worker"           type="STRING" key="worker"/>
        <field name="Submit"           type="STRING" key="submit"/>
        <field name="Budget Structure*" type="STRING" key="budgetStructure"/>
        <field name="Budget Name*"     type="STRING" key="budgetName"/>
        <field name="Budget Memo"      type="STRING" key="budgetMemo"/>
        <field name="Budget Period"    type="STRING" key="budgetPeriod"/>
    </sheet>

    <sheet name="Budget Lines Data" num-header-rows="5" start-column-index="1"
           business-object-class="edu.cornell.kfs.cemi.module.cg.batch.businessobject.CemiImportBudgetFileBudgetLinesDataTabRowBo">
        <field name="Header Key"                               type="STRING" key="headerKey"/>
        <field name="Line Key"                                 type="STRING" key="lineKey"/>
        <field name="Line Order"                               type="STRING" key="lineOrder"/>
        <field name="Company*"                                 type="STRING" key="company"/>
        <field name="Year"                                     type="STRING" key="year"/>
        <field name="Fiscal Time Interval"                     type="STRING" key="fiscalTimeInterval"/>
        <field name="Ledger Account or Ledger Account Summary" type="STRING" key="ledgerAccountOrLedgerAccountSummary"/>
        <field name="Account Set"                              type="STRING" key="accountSet"/>
        <field name="Book Code"                                type="STRING" key="bookCode"/>
        <field name="Budget Currency"                          type="STRING" key="budgetCurrency"/>
        <field name="Budget Debit Amount"                      type="STRING" key="budgetDebitAmount"/>
        <field name="Budget Credit Amount"                     type="STRING" key="budgetCreditAmount"/>
        <field name="Quantity"                                 type="STRING" key="quantity"/>
        <field name="Unit of Time"                             type="STRING" key="unitOfTime"/>
        <field name="Memo"                                     type="STRING" key="memo"/>
        <field name="Grant_ID"                                 type="STRING" key="grantId"/>
        <field name="Object_Class_ID"                          type="STRING" key="objectClassId"/>
        <field name="External Supplier Invoice Source"         type="STRING" key="externalSupplierInvoiceSource"/>
    </sheet>

</cemiOutputDefinition>
